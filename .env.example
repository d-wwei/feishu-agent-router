# Feishu identities are handled by an explicit local lark-cli profile.
# Do not leave these blank for a launchd bridge: each Feishu bot/app must have
# one dedicated profile and one router process.
FTB_LARK_AS=bot
FTB_LARK_PROFILE=bot-profile-name
FTB_LARK_APP_ID=cli_xxx

# FTB_ALLOWED_SENDERS uses im.message.receive_v1 sender_id, which is open_id.
# open_id is app-scoped: after changing Feishu bot/app, recapture sender_id with
# `farctl allowlist-capture` before expecting replies.
FTB_ALLOWED_SENDERS=ou_xxx
FTB_ALLOWED_CHATS=
FTB_ALLOW_UNRESTRICTED=false
FTB_ADMIN_USERS=ou_xxx
FTB_ALLOW_ADMIN_ALL=false

# When enabled, the first plain message in a new group creates and binds a
# dedicated session for that group. Disable if you only want slash commands in
# groups.
FTB_AUTO_CREATE_GROUP_SESSIONS=true
FTB_AUTO_GROUP_SESSION_PREFIX=group

# Keep group usage explicit when auto group sessions are disabled. Private chat
# plain messages are always routed.
FTB_GROUP_REQUIRE_COMMAND=true

# Runtime state. For real use, point this outside the repo.
FTB_HOME=/Users/admin/.feishu-agent-router

# Default session created when data/sessions.json does not exist.
FTB_DEFAULT_SESSION=main
FTB_DEFAULT_BACKEND=codex-app-server
FTB_DEFAULT_AGENT=codex
FTB_TMUX_SESSION=far-main
FTB_WORKDIR=/Users/admin
FTB_AGENT_CMD=codex --no-alt-screen --cd /Users/admin --sandbox danger-full-access -a never

# Codex app-server backend. Leave model empty to use the local Codex default.
# Default policy is remote-office mode: no approval prompts and no sandbox
# restrictions. Override these values if you want a more constrained session.
FTB_CODEX_PATH=codex
# Current Codex supports stdio://, unix://, and unix://PATH. stdio:// is the
# simplest local bridge and avoids the old unsupported ws:// transport.
FTB_CODEX_APP_SERVER_LISTEN=stdio://
FTB_CODEX_PROFILE=
FTB_CODEX_MODEL=
FTB_CODEX_MODEL_PROVIDER=
FTB_CODEX_SERVICE_TIER=
FTB_CODEX_REASONING_EFFORT=medium
FTB_CODEX_SANDBOX=danger-full-access
FTB_CODEX_APPROVAL_POLICY=never
FTB_CODEX_NETWORK_ACCESS=true
FTB_CODEX_AUTO_APPROVE_REQUESTS=true
# Disable Codex response websockets by default for bridge stability; HTTP
# streaming avoids stalls before the first model event on some networks.
FTB_CODEX_RESPONSES_WEBSOCKETS=false
# Newer Codex builds ignore the removed responses_websockets feature for the
# built-in ChatGPT provider. Set this to true only if this deployment needs an
# explicit local provider override with wire_api="responses".
FTB_CODEX_FORCE_RESPONSES_HTTP=false
FTB_CODEX_HTTP_PROVIDER_ID=chatgpt_http
FTB_CODEX_HTTP_PROVIDER_NAME=ChatGPT HTTP
FTB_CODEX_HTTP_PROVIDER_BASE_URL=https://chatgpt.com/backend-api/codex
# Automatic tmux fallback is disabled by default. A broken tmux Codex CLI can
# leak terminal UI text back to Feishu and create extra local Codex sessions.
FTB_ENABLE_TMUX_FALLBACK=false
# Prestart Codex app-server and resume/create hot sessions when the bridge
# starts, instead of paying this cost on the first Feishu message.
FTB_PREWARM_CODEX=true
FTB_PREWARM_SESSIONS=main
# Optional model-level warmup turn. Disabled by default to avoid extra token use.
FTB_PREWARM_TURN=false
FTB_CODEX_REQUEST_TIMEOUT_MS=120000
FTB_CODEX_START_TIMEOUT_MS=8000
FTB_CODEX_FIRST_OUTPUT_TIMEOUT_MS=90000
FTB_CODEX_TURN_IDLE_TIMEOUT_MS=300000
FTB_CODEX_TURN_HARD_TIMEOUT_MS=0

# Feishu UX features. These are best-effort and fall back to plain replies.
FTB_FEISHU_RICH_REPLIES=true
FTB_FEISHU_REACTIONS=true
FTB_FEISHU_STREAMING=auto
FTB_COLD_START_CARD_DELAY_MS=1500
FTB_FEISHU_STREAM_START_DELAY_MS=5000
FTB_FEISHU_STREAM_MIN_CHARS=240
FTB_FEISHU_STREAM_PATCH_MS=2000

# Capture tuning.
FTB_MAX_WAIT_MS=90000
FTB_STABLE_MS=3500
FTB_POLL_MS=1000
FTB_CAPTURE_LINES=1200
FTB_REPLY_MAX_CHARS=3500
FTB_RESTART_DELAY_MS=3000

# Disabled by default. Set to a positive value and mark sessions with
# "idleStop": true in sessions.json to auto-stop idle tmux sessions.
FTB_IDLE_STOP_MS=0
